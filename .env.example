# --- Chain ---
# Use your free Chainstack Growth endpoint (hackathon perk) for reliability.
CELO_RPC_URL=https://forno.celo.org

# Your maker wallet. Read-only here: this repo never signs with it.
MAKER_ADDRESS=0x0000000000000000000000000000000000000000

# Token addresses on Celo mainnet (chainId 42220).
# USDT on Celo:
USDT_ADDRESS=0x48065fbbe25f71c9282ddf5e1cd6d6a887483d5e
# cNGN (Compliant Naira, 6dp) on Celo, from Textile's address book
# (docs.textilecredit.com/protocol/address-book). Do NOT use Mento's old
# "Celo Nigerian Naira" (NGNm / former cNGN); it is a different token.
CNGN_ADDRESS=0xF6829D7393dAe24509eb1E52eE8e572e2E271a4f

# --- Pricing (all in basis points, 1 bps = 0.01%) ---
# Half-spread around the reference mid. Live USDT/NGN spread on Textile was
# ~4 bps total on Oct 26, so start near 2-3 bps a side to compete.
BASE_HALF_SPREAD_BPS=2
# Max shift of both quotes when inventory is fully one-sided.
MAX_SKEW_BPS=20
# Extra half-spread per 1 bps of recent mid volatility.
VOL_WIDEN_MULT=0.5
# Cap on the volatility add-on.
MAX_VOL_WIDEN_BPS=15
# Stop quoting if reference sources disagree by more than this.
DIVERGENCE_HALT_BPS=60
# Target share of inventory value held in USDT (0.5 = balanced).
TARGET_USDT_SHARE=0.5
# Never commit more than this share of one side to a single quote.
MAX_SIZE_SHARE=0.9

# --- Loop ---
QUOTE_INTERVAL_MS=3000
# Where quote levels are written for the quoting engine to pick up.
QUOTE_SINK=console   # console | file | feed (feed = serve price for Stitch [feed] url)
FEED_PORT=8787
FEED_INVERT=1        # Stitch feed price is USDT per cNGN (debt per collateral); set 0 to serve NGN per USDT
QUOTE_FILE=./data/levels.json

# --- Independent rate-shock guard (NGN per USDT), never used to set the price ---
# Defaults to CoinGecko USDT/NGN. The Textile premium to it (~360 bps) is normal;
# the bot halts only when that basis jumps (see src/rates/basis.ts).
# Any HTTPS JSON endpoint; REF_FIELD is a dot path to the number.
# Example shape only -- verify the API before relying on it.
REF_URL=
REF_FIELD=
REF_NAME=coingecko

# Only scan swaps from this unix time on (start of the hackathon run).
FILLS_SINCE=1793046000
